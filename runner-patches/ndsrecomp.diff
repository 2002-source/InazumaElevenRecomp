+bool ie1_menu_en_espanol() {
+    static int es = -1;
+    if (es < 0) {
+        std::string idioma = "en";
+        if (const char* e = std::getenv("IE1_TEXTOS"); e && *e) idioma = e;
+        else if (std::FILE* f = std::fopen("idiomas.cfg", "r")) {
+            char l[128];
+            while (std::fgets(l, sizeof l, f))
+                if (!std::strncmp(l, "textos=", 7)) {
+                    idioma = l + 7;
+                    while (!idioma.empty() && (idioma.back() == '\n' || idioma.back() == '\r' || idioma.back() == ' ')) idioma.pop_back();
+                }
+            std::fclose(f);
+        }
+        es = idioma == "es" ? 1 : 0;
+        g_ie1_menu_lang = idioma == "es" ? 1 : idioma == "fr" ? 2 : (idioma == "de" || idioma == "ge") ? 3 : idioma == "it" ? 4 : 0;
+    }
+    return es == 1;
+}
+int ie1_menu_idioma() { ie1_menu_en_espanol(); return g_ie1_menu_lang; }
+const char* ie1_tr3(const char* en) {        // ingles -> frances, aleman o italiano
+    const int l = ie1_menu_idioma();
+    if (l < 2 || !en) return en;
+    for (const auto& x : kIe1Traducciones3)
+        if (!std::strcmp(en, x.en)) return l == 2 ? x.fr : l == 3 ? x.de : x.it;
+    return en;
+}
+const char* ie1_tr(const char* t) {
+    if (!t) return t;
+    const bool es = ie1_menu_en_espanol();
+    for (const auto& x : kIe1Traducciones)
+        if (!std::strcmp(t, x.original)) return es ? x.es : ie1_tr3(x.en);
+    static std::vector<std::string> avisados;
+    if (*t && std::find(avisados.begin(), avisados.end(), t) == avisados.end()) {
+        avisados.push_back(t);
+        std::fprintf(stderr, "[menu] sin traducir: \"%s\"\n", t);
+    }
+    return t;
+}
+// IE1_MENU_INFO_MODS: nombre y descripcion de cada mod (mod.txt), en su idioma
+std::string ie1_mod_campo(int i, const char* clave) {
+    const char* carpeta = ie1_mods_nombre(i);
+    if (!carpeta || !*carpeta) return {};
+    std::vector<std::string> dirs;
+    if (const char* e = std::getenv("IE1_MODS_DIR"); e && *e) dirs.push_back(e);
+    dirs.push_back("../mods"); dirs.push_back("mods");
+    for (const auto& d : dirs) {
+        std::FILE* f = std::fopen((d + "/" + carpeta + "/mod.txt").c_str(), "r");
+        if (!f) continue;
+        std::string base, en, l;
+        char linea[1024];
+        const std::string k = clave, ken = k + "_en";
+        static const char* const kSufijo[5] = {"", "", "_fr", "_de", "_it"};  // IE1_MENU_5IDIOMAS
+        const std::string kloc = k + kSufijo[ie1_menu_idioma()];
+        std::string loc;
+        while (std::fgets(linea, sizeof linea, f)) {
+            l = linea;
+            while (!l.empty() && (l.back() == '\n' || l.back() == '\r')) l.pop_back();
+            const size_t eq = l.find('=');
+            if (eq == std::string::npos) continue;
+            if (l.compare(0, eq, k) == 0 && eq == k.size()) base = l.substr(eq + 1);
+            if (l.compare(0, eq, ken) == 0 && eq == ken.size()) en = l.substr(eq + 1);
+            if (ie1_menu_idioma() >= 2 && l.compare(0, eq, kloc) == 0 && eq == kloc.size()) loc = l.substr(eq + 1);
+        }
+        std::fclose(f);
+        if (!loc.empty()) return loc;
+        return (!ie1_menu_en_espanol() && !en.empty()) ? en : base;
+    }
+    return {};
+}
+const char* ie1_mod_nombre_ui(int i, const char* respaldo) {
+    static std::string nombres[16];
+    if (i < 0 || i >= 16) return respaldo;
+    nombres[i] = ie1_mod_campo(i, "nombre");
+    return nombres[i].empty() ? respaldo : nombres[i].c_str();
+}
+const char* ie1_mod_descripcion(int i) {   // IE1_MENU_INFO_MODS2: una sola linea (IE1_MENU_5IDIOMAS)
+    (void)i;
+    static const char* const k[5] = {
+        "Turn on or off (on restart). Info: launcher, Tab.",
+        "Activar o desactivar (al reiniciar). Info: lanzador, Tab.",
+        "Activer ou desactiver (au redemarrage). Infos : lanceur, Tab.",
+        "An- oder ausschalten (nach Neustart). Infos: Starter, Tab.",
+        "Attiva o disattiva (al riavvio). Info: launcher, Tab."};
+    return k[ie1_menu_idioma()];
+}
